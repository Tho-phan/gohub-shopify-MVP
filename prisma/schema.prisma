// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// One row per (shop, GoHub plan). Holds the reseller's sale price and,
/// once pushed, the Shopify product/variant ids for order->plan matching.
model ResellerPlan {
  id                      String    @id @default(cuid())
  shop                    String
  gohubPlanId             String
  salePrice               String // money as string, e.g. "9.00" (Shopify convention)
  active                  Boolean   @default(true)
  shopifyProductGid       String? // gid://shopify/Product/...
  shopifyVariantGid       String? // gid://shopify/ProductVariant/...
  shopifyVariantNumericId String? // "123..." - matches orders/paid payload variant_id
  pushedAt                DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([shop, gohubPlanId])
  @@index([shop, shopifyVariantNumericId])
}

/// One row per Shopify paid order that contains eSIM line items. Tracks the
/// GoHub order through its async lifecycle (created -> polled -> fulfilled).
/// idempotencyKey = Shopify order id, so webhook retries never double-order.
model GohubOrder {
  id               String    @id @default(cuid())
  shop             String
  idempotencyKey   String    @unique // Shopify order id
  shopifyOrderId   String
  shopifyOrderName String
  customerEmail    String
  currency         String
  items            String    @default("[]") // JSON [{ code, quantity }] — lets the poller re-place a stranded order
  gohubOrderCode   String? // from POST /orders, used to poll GET /orders/{code}
  status           String    @default("PENDING") // PENDING | FULFILLED | FAILED | NO_BALANCE
  attempts         Int       @default(0)
  lastError        String?
  emailSentAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

/// One row per eSIM profile returned by GoHub once an order is fulfilled.
model ProvisionedEsim {
  id                  String    @id @default(cuid())
  shop                String
  gohubOrderCode      String
  iccid               String    @unique
  lpa                 String
  qrImageUrl          String?
  planName            String
  activationExpiresAt DateTime?
  expiresAt           DateTime?
  customerEmail       String
  createdAt           DateTime  @default(now())

  @@index([shop])
  @@index([gohubOrderCode])
}
